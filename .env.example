# Bomahut GraphQL endpoint. PM-Sites is READ-ONLY against this: the client
# refuses to send anything that is not a plain query.
BOMAHUT_GRAPHQL_URL=https://api.bomahut.com/graphql

# Optional. Only needed while `publicVacancies` is still behind auth — leave
# unset once the anonymous public query is live in production.
# BOMAHUT_API_TOKEN=

# Which client to render when the Host header matches no configured brand
# (Vercel preview URLs, localhost). Use a real slug from src/clients.
PM_SITES_DEFAULT_CLIENT=ferrum

# Overrides the canonical origin used in metadata, sitemap and robots.
# Leave unset in production so each brand uses its own domain.
# PM_SITES_CANONICAL_ORIGIN=http://localhost:3000

# Make.com webhook that receives enquiries. A brand may override this in its
# own config (`enquiryWebhookUrl`); this is the fallback.
MAKE_ENQUIRY_WEBHOOK_URL=
