# Development only. A published site gets its backend address from the data the
# backend writes into the page, never from the build.
#
# Where the sample sites look for listings and send forms while running
# `npm run dev`. Leave unset to see the "availability is temporarily
# unavailable" states; add ?listings=sample to a dev address for made-up houses.
# VITE_DEV_API_BASE=http://localhost:8000/api

# The agency slug the samples ask listings for on that backend.
# VITE_DEV_AGENCY=tembo-hart
